#!/usr/bin/env bash

set -euo pipefail

show_help() {
  cat <<'EOF'
Usage: scripts/chess-practice [tactics-trainer options]

Fetch a new puzzle after each solved tactic.
All options are forwarded to tactics-trainer.
The wrapper also accepts --tag as an alias for --tags.
With no options, it defaults to --rating=600-1200.
If tactics-trainer is not installed, it falls back to cargo run.

Examples:
  scripts/chess-practice --rating=600-1200
  scripts/chess-practice --tag mateIn1
EOF
}

if [[ -n "${TACTICS_TRAINER_BIN:-}" ]]; then
  trainer_cmd=("$TACTICS_TRAINER_BIN")
elif command -v tactics-trainer >/dev/null 2>&1; then
  trainer_cmd=(tactics-trainer)
else
  trainer_cmd=(cargo run --quiet --bin tactics-trainer --)
fi

args=()

if (($# == 0)); then
  args+=(--rating=600-1200)
fi

while (($#)); do
  case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    --tag)
      if (($# == 1)); then
        echo "scripts/chess-practice: --tag requires a value" >&2
        exit 64
      fi
      args+=(--tags "$2")
      shift
      ;;
    --tag=*)
      args+=("--tags=${1#--tag=}")
      ;;
    *)
      args+=("$1")
      ;;
  esac
  shift
done

while true; do
  "${trainer_cmd[@]}" "${args[@]}"
done
