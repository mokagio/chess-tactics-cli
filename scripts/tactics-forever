#!/usr/bin/env bash

set -euo pipefail

show_help() {
  cat <<'EOF'
Usage: scripts/tactics-forever [tactics-trainer options]

Fetch a new puzzle after each solved tactic.
All options are forwarded to tactics-trainer.
The wrapper also accepts --tag as an alias for --tags.

Examples:
  scripts/tactics-forever --rating=600-1200
  scripts/tactics-forever --tag mateIn1
EOF
}

trainer_bin=${TACTICS_TRAINER_BIN:-tactics-trainer}
args=()

while (($#)); do
  case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    --tag)
      if (($# == 1)); then
        echo "scripts/tactics-forever: --tag requires a value" >&2
        exit 64
      fi
      args+=(--tags "$2")
      shift
      ;;
    --tag=*)
      args+=("--tags=${1#--tag=}")
      ;;
    *)
      args+=("$1")
      ;;
  esac
  shift
done

while true; do
  "$trainer_bin" "${args[@]}"
done
